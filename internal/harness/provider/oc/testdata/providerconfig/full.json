{
  "$schema": "https://opencode.ai/config.json",
  "model": "bedrock-p1/deepseek-chat",
  "agents": {
    "title": {
      "providerID": "bedrock-p1",
      "model": "deepseek-chat"
    }
  },
  "providers": {
    "bedrock-p1": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "DeepSeek 官方",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/api/v1/ai",
        "apiKey": "br_harness_loopback"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek Chat"
        },
        "deepseek-reasoner": {
          "name": "DeepSeek Reasoner",
          "settings": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "bedrock-p2": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "本地网关",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/api/v1/ai",
        "apiKey": "br_harness_loopback"
      },
      "models": {
        "qwen-max": {
          "name": "Qwen Max"
        }
      }
    }
  }
}
